	<!--
	P2-002/P2-003/P2-004/P2-005/P7-001 (SSDP discovery, MQTT, FTPS upload,
	camera snapshot): all real `Network.framework` connections to the
	printer's LAN IP (`PrinterDiscovery`'s `NWListener` receives SSDP
	multicast replies — an inbound local-network listener, the specific
	case macOS's Local Network privacy prompt gates). Required so macOS
	actually shows the permission prompt instead of silently failing
	discovery once this ships as a real `.app` (P8-006) rather than a
	bare unsandboxed executable.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>NativeSlicerA1 discovers and connects to Bambu Lab A1 printers on your local network to upload files, monitor print status, and fetch chamber camera snapshots.</string>
	<!--
	P5-003 (MyMiniFactory OAuth): registers this app as the handler for
	the custom `nativeslicera1://` scheme so ASWebAuthenticationSession's
	real OAuth redirect (MyMiniFactoryOAuth.redirectURI) can route back to
	this process. Also embedded into the executable's Mach-O
	`__TEXT,__info_plist` section by Package.swift's linker flags (the
	standard technique for a bare SwiftPM executable run outside a
	bundle) so `Bundle.main.infoDictionary` reports it either way.

	`Scripts/package-app.sh` (P8-006) packages a real `.app` from this
	same plist (as `Contents/Info.plist`) and registers it with Launch
	Services (`lsregister -f`), so the OS can route the redirect back to
	this process — this is now GUI-reachable via a packaged build, not
	only unit-tested. Live OAuth completion still depends on the OS
	actually completing the browser round trip (P5-005's Cloudflare
	blocker in this environment), independent of packaging itself.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nativeslicera1.NativeSlicerA1.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nativeslicera1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
